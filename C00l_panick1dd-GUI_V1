local flying,flyConn,bv,bg=false,nil,nil,nil
local spinning,spinConn=false,nil
local function setFly(on)
    flying=on
    if flyConn then flyConn:Disconnect(); flyConn=nil end
    if bv then bv:Destroy(); bv=nil end
    if bg then bg:Destroy(); bg=nil end
    pad.Visible=on and UIS.TouchEnabled
    if not on then for k in pairs(dirs) do dirs[k]=false end; notify("Fly desativado"); return end
    local r=root()
    if not r then flying=false; pad.Visible=false; notify("Personagem não carregou"); return end
    bv=Instance.new("BodyVelocity"); bv.MaxForce=Vector3.new(1e5,1e5,1e5); bv.Parent=r
    bg=Instance.new("BodyGyro"); bg.MaxTorque=Vector3.new(1e5,1e5,1e5); bg.P=10000; bg.CFrame=r.CFrame; bg.Parent=r
    flyConn=RunService.RenderStepped:Connect(function()
        if not bv or not bg then return end
        local cam=workspace.CurrentCamera; if not cam then return end
        local v=Vector3.zero
        if UIS:IsKeyDown(Enum.KeyCode.W) or dirs.forward then v+=cam.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.S) or dirs.backward then v-=cam.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.A) or dirs.left then v-=cam.CFrame.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.D) or dirs.right then v+=cam.CFrame.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.Space) or dirs.up then v+=Vector3.yAxis end
        if UIS:IsKeyDown(Enum.KeyCode.LeftControl) or dirs.down then v-=Vector3.yAxis end
        bv.Velocity=v.Magnitude>0 and v.Unit*42 or Vector3.zero; bg.CFrame=cam.CFrame
    end)
    notify("Fly ativado")
end

local invisible,noclip,esp,infiniteJump=false,false,false,false
local noclipConn,jumpConn
local oldCollision,highlights={},{}
local savedPos
local function setInvisible(on)
    invisible=on; local c=char(); if not c then return end
    for _,o in ipairs(c:GetDescendants()) do
        if o:IsA("BasePart") then o.LocalTransparencyModifier=on and 1 or 0
        elseif o:IsA("Decal") then o.Transparency=on and 1 or 0 end
    end
    notify(on and "Invisibilidade local ativada" or "Visibilidade restaurada")
end
local function setNoclip(on)
    noclip=on
    if noclipConn then noclipConn:Disconnect(); noclipConn=nil end
    if not on then
        for p,v in pairs(oldCollision) do if p.Parent then p.CanCollide=v end end
        table.clear(oldCollision); notify("Colisão restaurada"); return
    end
    noclipConn=RunService.Stepped:Connect(function()
        local c=char()
        if c then for _,p in ipairs(c:GetDescendants()) do if p:IsA("BasePart") then
            if oldCollision[p]==nil then oldCollision[p]=p.CanCollide end; p.CanCollide=false
        end end end
    end)
    notify("Noclip local ativado")
end
local function setESP(on)
    esp=on
    for _,h in pairs(highlights) do if h then h:Destroy() end end
    table.clear(highlights)
    if on then for _,plr in ipairs(Players:GetPlayers()) do
        if plr~=player and plr.Character then
            local h=Instance.new("Highlight"); h.Adornee=plr.Character; h.FillColor=RED2
            h.OutlineColor=WHITE; h.FillTransparency=.5; h.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
            h.Parent=gui; highlights[plr]=h
        end
    end end
    notify(on and "ESP ativado" or "ESP desativado")
end
local function setInfiniteJump(on)
    infiniteJump=on
    if jumpConn then jumpConn:Disconnect(); jumpConn=nil end
    if on then jumpConn=UIS.JumpRequest:Connect(function() local h=hum(); if h and h.Health>0 then h:ChangeState(Enum.HumanoidStateType.Jumping) end end) end
    notify(on and "Salto infinito ativado" or "Salto infinito desativado")
end
